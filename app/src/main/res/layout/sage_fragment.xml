<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/subjectView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">
                <TextView
                    android:id="@+id/disciplineView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="哲学"
                    android:gravity="center"
                    android:background="@drawable/editview_border"/>
                <TextView
                    android:id="@+id/majorView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="哲学类"
                    android:gravity="center"
                    android:background="@drawable/editview_border"/>
                <TextView
                    android:id="@+id/trackView"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:text="哲学"
                    android:gravity="center"
                    android:background="@drawable/editview_border"/>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/adviceRv"
                android:layout_width="match_parent"
                android:layout_height="@dimen/none"
                android:layout_weight="1"
                android:layout_marginTop="5dp"/>
        </LinearLayout>
        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="@dimen/fabMargin"
            android:layout_marginBottom="@dimen/fabMargin">
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/advice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:elevation="5dp"
                android:src="@drawable/post_vector"
                android:importantForAccessibility="no"/>
        </RelativeLayout>
    </FrameLayout>

</layout>